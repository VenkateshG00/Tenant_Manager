# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API).
#
# Only the publishable (anon) key belongs in the browser. NEVER put the
# service_role key in any VITE_* variable — it would be shipped to every
# visitor.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# If either variable is missing the app starts in DEMO MODE with fictional
# in-memory sample data (clearly banner-labelled) so you can try the UI.

https://xhbdhxynyanoxrhoetei.supabase.co